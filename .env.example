# 2. Optional Permanent Serverless Database (Vercel KV / Upstash Redis — 1-click in Vercel Storage)
# Without this, Vercel uses fast writable `/tmp` storage automatically with zero errors.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
