# Optional Environment Variables for Vercel Dashboard (Project Settings -> Environment Variables)

# 1. Owner Admin PIN & Payment Gateway Settings
MERCHANT_NAME="Arrow Puzzle: Arena"
MERCHANT_ADMIN_PIN="2580"
MERCHANT_UPI_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
